{
  "schema_version": 2,
  "description": "Catalog of models the pipeline expects + per-feature install set scoping. pipeline_doctor.py reads this for disk preflight and warm-cache scoping. Structurally validated in CI on PRs touching scripts/ or tools/_embed_lib.py.",
  "tier_defaults": {
    "laptop": {
      "include": []
    },
    "studio": {
      "include": [
        "hunyuan3d-paint"
      ]
    }
  },
  "prereqs": [
    {
      "id": "python",
      "kind": "binary",
      "name": "python3",
      "min_version": "3.10",
      "max_version": "3.12",
      "max_version_severity": "warn",
      "install_hint": "brew install python@3.12"
    },
    {
      "id": "brew",
      "kind": "binary",
      "name": "brew",
      "install_hint": "see https://brew.sh"
    },
    {
      "id": "git",
      "kind": "binary",
      "name": "git"
    },
    {
      "id": "huggingface-cli",
      "kind": "binary",
      "name": "huggingface-cli",
      "install_hint": "pip install huggingface_hub[cli]"
    },
    {
      "id": "pip",
      "kind": "python_package",
      "name": "pip",
      "min_version": "23.1",
      "install_hint": "python3 -m pip install --upgrade pip"
    },
    {
      "id": "gltfpack",
      "kind": "binary",
      "name": "gltfpack",
      "required": false,
      "version_flag": "",
      "install_hint": "no Homebrew formula exists -- download gltfpack-macos.zip from https://github.com/zeux/meshoptimizer/releases, unzip, and place the gltfpack binary on your PATH (item 23; generate.sh --lods / --reuv's optimize pass)"
    }
  ],
  "mutable_embed_paths": [],
  "studio_extras": {
    "queue_dirs": [
      "queue/pending",
      "queue/running",
      "queue/done",
      "queue/failed"
    ],
    "launchd_plist": {
      "label": "com.kenallred.3dpipeline.queue-worker",
      "template": "scripts/launchd/queue-worker.plist.tmpl",
      "dest_path": "~/Library/LaunchAgents/com.kenallred.3dpipeline.queue-worker.plist",
      "optional": true
    },
    "heartbeat_file": "queue/.heartbeat-<machine>",
    "heartbeat_max_age_seconds": 90,
    "heartbeat_write_timeout_seconds": 25
  },
  "feature_sets": {
    "tier1": {
      "description": "Default v0.3 quality features (always recommended)",
      "components": [
        "u2net",
        "clip-vit-l-14"
      ]
    },
    "hunyuan3d-paint": {
      "description": "Item 7 \u2014 Hunyuan3D-Paint texture painting (commercial_threshold)",
      "components": [
        "hunyuan3d-paint"
      ]
    },
    "comfyui": {
      "description": "Item 11 \u2014 ComfyUI consistency mode (LoRA + IP-Adapter + ControlNet)",
      "components": [
        "sdxl-base",
        "ip-adapter-faceid-sdxl",
        "controlnet-openpose",
        "controlnet-canny"
      ]
    },
    "multiview": {
      "description": "Item 12 \u2014 multi-view reconstruction backend (specific model TBD post-research)",
      "components": []
    },
    "vlm-judge": {
      "description": "Item 17 \u2014 local VLM judge for 2D concepts (opt-in; concept.sh --judge / --best-of)",
      "components": [
        "qwen3-vl-judge"
      ]
    },
    "trellis2": {
      "description": "Item 15 \u2014 TRELLIS.2 2D-to-3D backend (opt-in; generate.sh -g trellis2). Bakes real PBR maps, unlike SF3D's scalar factors.",
      "components": [
        "trellis2-weights",
        "dinov3-encoder"
      ]
    },
    "edit-lane": {
      "description": "Item 21 \u2014 instruction-based image editing + parametric camera-angle views (opt-in; edit.sh). Runs through the existing mflux-env venv, no separate install.",
      "components": [
        "qwen-image-edit-2511",
        "qwen-multi-angle-lora"
      ]
    }
  },
  "venvs": [
    {
      "name": "mflux-env",
      "path": "~/3d-pipeline/mflux-env",
      "required": true,
      "feature_set": "tier1",
      "size_gb": 8,
      "purpose": "2D generation (Z-Image Turbo / FLUX schnell / FLUX dev / FLUX.2 klein / ERNIE-Image)",
      "python_version": "3.12",
      "lockfile": "scripts/lockfiles/mflux-env.txt",
      "min_package_version": { "package": "mflux", "version": "0.18" }
    },
    {
      "name": "pipeline-tools-env",
      "path": "~/3d-pipeline/pipeline-tools-env",
      "required": true,
      "feature_set": "tier1",
      "size_gb": 6,
      "purpose": "Quality-check scripts (trimesh, rembg, open_clip)",
      "import_check": "trimesh, numpy, scipy, PIL, rembg, open_clip, torch, tqdm, requests",
      "python_version": "3.12",
      "lockfile": "scripts/lockfiles/pipeline-tools-env.txt"
    },
    {
      "name": "hunyuan3d-paint-env",
      "path": "~/3d-pipeline/hunyuan3d-paint-mlx/.venv",
      "required": false,
      "feature_set": "hunyuan3d-paint",
      "size_gb": 6,
      "purpose": "Item 19 retarget: dgrauet/Hunyuan3D-2.1-mlx (Apple Silicon MLX port -- upstream Hunyuan3D-Paint needs CUDA, unavailable on Mac). Community fork pinned per principle P-B.",
      "python_version": "3.12",
      "lockfile": "scripts/lockfiles/hunyuan3d-paint-env.txt",
      "pinned_commit": "5fe21945b790fbb7fb28c510e89babd7b9feabe6",
      "repo_path": "~/3d-pipeline/hunyuan3d-paint-mlx"
    },
    {
      "name": "comfyui-env",
      "path": "~/3d-pipeline/comfyui-env",
      "required": false,
      "feature_set": "comfyui",
      "size_gb": 10,
      "purpose": "ComfyUI consistency mode (Item 11)",
      "python_version": "3.12",
      "lockfile": "scripts/lockfiles/comfyui-env.txt"
    },
    {
      "name": "multiview-env",
      "path": "~/3d-pipeline/multiview-env",
      "required": false,
      "feature_set": "multiview",
      "size_gb": 6,
      "purpose": "Multi-view reconstruction (Item 12)",
      "python_version": "3.12",
      "lockfile": "scripts/lockfiles/multiview-env.txt"
    },
    {
      "name": "vlm-env",
      "path": "~/3d-pipeline/vlm-env",
      "required": false,
      "feature_set": "vlm-judge",
      "size_gb": 2,
      "purpose": "Local VLM judge (mlx-vlm) for concept.sh --judge / --best-of",
      "python_version": "3.12",
      "lockfile": "scripts/lockfiles/vlm-env.txt"
    },
    {
      "name": "trellis2-env",
      "path": "~/3d-pipeline/trellis2-mac",
      "required": false,
      "feature_set": "trellis2",
      "size_gb": 2,
      "purpose": "TRELLIS.2 2D-to-3D backend (generate.sh -g trellis2). Community fork pinned per principle P-B.",
      "python_version": "3.11",
      "lockfile": "scripts/lockfiles/trellis2-env.txt",
      "pinned_commit": "d58628f4f5b9c3de8274cb110074154f4b31cef2",
      "repo_path": "~/3d-pipeline/trellis2-mac"
    },
    {
      "name": "edit-lane",
      "path": "~/3d-pipeline/mflux-env",
      "required": false,
      "feature_set": "edit-lane",
      "size_gb": 0,
      "purpose": "Item 21 — not a separate install. Shares the mflux-env venv (mflux-generate-qwen-edit); this entry exists only so the edit-lane feature_set has a venv to check against.",
      "python_version": "3.12",
      "lockfile": "scripts/lockfiles/mflux-env.txt"
    }
  ],
  "models": [
    {
      "id": "u2net",
